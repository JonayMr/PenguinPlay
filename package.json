{
  "name": "penguinplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AirPlay screen and audio receiver for Linux",
  "author": "JonayMr",
  "desktopName": "penguinplay",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.penguinplay.desktop",
    "productName": "PenguinPlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json",
      "scripts/**/*",
      "PenguinPlay.txt"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "assets/penguinplay.png",
      "syncDesktopName": true,
      "synopsis": "AirPlay screen and audio receiver",
      "description": "Mirror your screen and receive audio from iOS devices on Linux. This installer includes UxPlay and GStreamer for Windows.",
      "artifactName": "PenguinPlay-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/penguinplay.ico",
      "artifactName": "PenguinPlay-Setup-${version}.${ext}",
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "perMachine": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "PenguinPlay",
        "runFromTemp": true,
        "allowElevation": true
      }
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "hosted-git-info": "^10.1.1"
  }
}
